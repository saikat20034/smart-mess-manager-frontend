# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# Leave empty to run in instant Demo Mode with sample data
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary CDN Configuration (Optional - for high-performance direct image uploads)
# Sign up free at https://cloudinary.com
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
